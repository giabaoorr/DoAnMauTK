@startuml use-case-diagram
!theme plain
skinparam defaultFontName "Segoe UI, Arial, sans-serif"
skinparam defaultFontSize 12
skinparam roundCorner 12
skinparam packageStyle rectangle
skinparam shadowing false

skinparam actor {
    BackgroundColor #E0F2FE
    BorderColor #0284C7
    FontColor #0F172A
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #9F224E
    BorderThickness 1.5
    FontColor #1E293B
    ArrowColor #64748B
}

left to right direction

' Tác nhân Người dùng (Bên trái)
actor "Khách vãng lai\n(Guest)" as Guest
actor "Độc giả thành viên\n(Member)" as Member

Member --|> Guest : Kế thừa quyền

' Ranh giới hệ thống
rectangle "ỨNG DỤNG ĐỌC BÁO ĐA NGUỒN (NEWS READER)" as System #F8FAFC {
    
    package "1. Phân hệ Duyệt & Đọc Tin" #EFF6FF {
        usecase "UC01: Xem dòng tin trang chủ" as UC01
        usecase "UC02: Lọc theo Nguồn & Chuyên mục" as UC02
        usecase "UC03: Sắp xếp tin đa tiêu chí" as UC03
        usecase "UC04: Tìm kiếm & Highlight từ khóa" as UC04
        usecase "UC05: Xem chi tiết toàn văn bài báo" as UC05
    }

    package "2. Phân hệ Đánh Dấu & Lưu Trữ" #ECFDF5 {
        usecase "UC06: Đánh dấu bài viết yêu thích" as UC06
        usecase "UC07: Quản lý danh sách đã lưu" as UC07
    }

    package "3. Phân hệ Quản Lý Tài Khoản" #FAF5FF {
        usecase "UC08: Đăng ký tài khoản" as UC08
        usecase "UC09: Đăng nhập hệ thống" as UC09
        usecase "UC10: Đăng xuất phiên làm việc" as UC10
    }

    package "4. Phân hệ Đồng Bộ RSS" #FFFBEB {
        usecase "UC11: Thu thập & Làm mới tin tức" as UC11
    }
}

' Tác nhân Hệ thống ngoài (Bên phải)
actor "4 Tòa Báo RSS\n(VnExpress, Tuổi Trẻ,\nThanh Niên, Dân Trí)" as RSS << External System >> #FEF3C7

' Liên kết của Khách vãng lai
Guest --> UC01
Guest --> UC02
Guest --> UC03
Guest --> UC04
Guest --> UC05
Guest --> UC06
Guest --> UC07
Guest --> UC08
Guest --> UC09
Guest --> UC11

' Liên kết riêng của Thành viên (Kế thừa giúp không cần nối lại các UC trên)
Member --> UC10

' Tác nhân ngoài nối từ bên phải vào
UC11 <-- RSS

' Quan hệ phụ thuộc Use Case
UC05 ..> UC06 : <<extend>>

@enduml
